DATABASE_URL="file:../data/leadflow.db"

# Fonte principal de busca: scraper | google_places | auto
LEADFLOW_PLACES_PROVIDER="scraper"

# Google Maps Scraper local
GOOGLE_MAPS_SCRAPER_URL="http://127.0.0.1:8080"
GOOGLE_MAPS_SCRAPER_API_KEY=""
# Deixe vazio para usar profundidade automática: 20=>2, 40=>3, 60=>4
GOOGLE_MAPS_SCRAPER_DEPTH=""

# Filtro geográfico do LeadFlow. O scraper pode trazer cidades vizinhas;
# por padrão elas são descartadas pelo município real retornado pelo Maps.
GOOGLE_MAPS_SCRAPER_STRICT_CITY="true"

# Metros. Também é usado pelo LeadFlow como barreira geográfica de segurança.
GOOGLE_MAPS_SCRAPER_RADIUS="10000"
GOOGLE_MAPS_SCRAPER_MAX_TIME="600"
GOOGLE_MAPS_SCRAPER_POLL_MS="2500"
GOOGLE_MAPS_SCRAPER_PROXIES=""

# Fallback opcional
GOOGLE_PLACES_API_KEY=""

# Roteamento de IA para criação de sites.
# LEADFLOW_SITE_MODEL deve apontar para o combo dedicado de criação de sites no OmniRoute.
# Ele é isolado do combo geral e de LEADFLOW_AI_FALLBACK_MODELS.
# Os campos por papel são overrides opcionais; deixe-os vazios para usar LEADFLOW_SITE_MODEL.
LEADFLOW_SITE_PROVIDER_NAME="LeadFlow"
LEADFLOW_SITE_PROVIDER_ID=""
LEADFLOW_SITE_MODEL=""
LEADFLOW_SITE_MODEL_CREATIVE=""
LEADFLOW_SITE_MODEL_ARCHITECT=""
LEADFLOW_SITE_MODEL_CODE=""
LEADFLOW_SITE_MODEL_REVIEW=""
LEADFLOW_SITE_MODEL_VISUAL_REVIEW=""

# Estabilidade do codegen V4
LEADFLOW_SITE_TIMEOUT_CREATIVE_MS="240000"
LEADFLOW_SITE_TIMEOUT_ARCHITECT_MS="240000"
LEADFLOW_SITE_TIMEOUT_CODE_MS="240000"
LEADFLOW_SITE_TIMEOUT_REVIEW_MS="180000"
LEADFLOW_SITE_TIMEOUT_VISUAL_REVIEW_MS="180000"
LEADFLOW_SITE_QUALITY_MIN_SCORE="78"
LEADFLOW_SITE_COMPONENT_CONCURRENCY="2"

# Fallbacks do combo geral do LeadFlow (CRM, qualificação e demais tarefas).
# Não são usados pelo pipeline de criação de sites.
LEADFLOW_AI_FALLBACK_MODELS=""
