generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  externalId    String?  @unique
  source        String?
  name          String
  segment       String?
  city          String?
  location      String?
  address       String?
  score         Int      @default(0)
  grade         String   @default("D")
  phone         String?
  whatsapp      String?
  email         String?
  instagram     String?
  site          String?
  weakSite      Boolean  @default(true)
  googleRating  String?
  googleReviews String?
  followers     Int?
  problem       String?
  offer         String?
  approach      String?
  nextAction    String?
  reason        String?
  mapsLink      String?
  bio           String?
  stage         String   @default("novo")
  notes         String   @default("")
  proposalValue Int      @default(0)
  landingStatus String   @default("none")
  followUpAt    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([stage])
  @@index([grade])
}

model IntentSignal {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  source         String
  sourceUrl      String?
  author         String?
  title          String?
  content        String
  query          String?
  publishedAt    String?
  matchedService String   @default("unknown")
  intentType     String   @default("other")
  buyerStage     String   @default("unknown")
  intentLevel    String   @default("unknown")
  urgencyScore   Int      @default(0)
  fitScore       Int      @default(0)
  confidence     Float    @default(0)
  explicitIntent Boolean  @default(false)
  intentScore    Int      @default(0)
  band           String   @default("low")
  reason         String?
  status         String   @default("new")
  leadId         String?
  rawPayload     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([intentScore])
  @@index([status])
  @@index([source])
}

model WhatsAppLeadLink {
  id        String   @id @default(cuid())
  sessionId String
  chatId    String
  leadId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, chatId])
  @@index([leadId])
}

model RecoveryDecision {
  id String @id @default(cuid())
  sessionId String
  chatId String
  status String @default("pending")
  reason String @default("")
  messageText String @default("")
  consentConfirmed Boolean @default(false)
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits RecoveryDecisionAudit[]
  @@unique([sessionId,chatId])
}
model RecoveryDecisionAudit {
  id String @id @default(cuid())
  decisionId String
  action String
  previousStatus String
  reason String @default("")
  messageSnapshot String?
  createdAt DateTime @default(now())
  decision RecoveryDecision @relation(fields:[decisionId],references:[id],onDelete:Cascade)
  @@index([decisionId])
}

model RecoveryDispatch {
  id String @id @default(cuid())
  sessionId String
  chatId String
  decisionId String
  dayKey String
  status String @default("reserved")
  messageSnapshot String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, chatId])
  @@index([sessionId, dayKey])
}

model RecoveryFollowupSnapshot {
 id String @id @default(cuid())
 sessionId String
 chatId String
 status String
 suggestion String
 messagesJson String
 nonTextCount Int @default(0)
 checkedAt DateTime @default(now())
 latestReplyAt DateTime?
 @@unique([sessionId,chatId])
 @@index([sessionId,checkedAt])
}
