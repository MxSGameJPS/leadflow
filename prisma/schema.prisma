generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String   @id @default(cuid())
  externalId    String?  @unique
  source        String?
  name          String
  segment       String?
  city          String?
  location      String?
  address       String?
  score         Int      @default(0)
  grade         String   @default("D")
  phone         String?
  whatsapp      String?
  email         String?
  instagram     String?
  site          String?
  weakSite      Boolean  @default(true)
  googleRating  String?
  googleReviews String?
  followers     Int?
  problem       String?
  offer         String?
  approach      String?
  nextAction    String?
  reason        String?
  mapsLink      String?
  bio           String?
  stage         String   @default("novo")
  notes         String   @default("")
  proposalValue Int      @default(0)
  landingStatus String   @default("none")
  followUpAt    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([stage])
  @@index([grade])
}

model IntentSignal {
  id             String   @id @default(cuid())
  fingerprint    String   @unique
  source         String
  sourceUrl      String?
  author         String?
  title          String?
  content        String
  query          String?
  publishedAt    String?
  matchedService String   @default("unknown")
  intentType     String   @default("other")
  buyerStage     String   @default("unknown")
  intentLevel    String   @default("unknown")
  urgencyScore   Int      @default(0)
  fitScore       Int      @default(0)
  confidence     Float    @default(0)
  explicitIntent Boolean  @default(false)
  intentScore    Int      @default(0)
  band           String   @default("low")
  reason         String?
  status         String   @default("new")
  leadId         String?
  rawPayload     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([intentScore])
  @@index([status])
  @@index([source])
}

model WhatsAppLeadLink {
  id        String   @id @default(cuid())
  sessionId String
  chatId    String
  leadId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, chatId])
  @@index([leadId])
}

model RecoveryDecision {
  id String @id @default(cuid())
  sessionId String
  chatId String
  status String @default("pending")
  reason String @default("")
  messageText String @default("")
  consentConfirmed Boolean @default(false)
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits RecoveryDecisionAudit[]
  @@unique([sessionId,chatId])
}
model RecoveryDecisionAudit {
  id String @id @default(cuid())
  decisionId String
  action String
  previousStatus String
  reason String @default("")
  messageSnapshot String?
  createdAt DateTime @default(now())
  decision RecoveryDecision @relation(fields:[decisionId],references:[id],onDelete:Cascade)
  @@index([decisionId])
}

model RecoveryDispatch {
  id String @id @default(cuid())
  sessionId String
  chatId String
  decisionId String
  dayKey String
  status String @default("reserved")
  messageSnapshot String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([sessionId, chatId])
  @@index([sessionId, dayKey])
}

model RecoveryFollowupSnapshot {
 id String @id @default(cuid())
 sessionId String
 chatId String
 status String
 suggestion String
 messagesJson String
 nonTextCount Int @default(0)
 checkedAt DateTime @default(now())
 latestReplyAt DateTime?
 reviewedReplyAt DateTime?
 reviewedAt DateTime?
 @@unique([sessionId,chatId])
 @@index([sessionId,checkedAt])
}

model RecoveryAiReview {
 id String @id @default(cuid())
 sessionId String
 chatId String
 category String
 reasoning String
 evidence String
 recommendedAction String
 draftReply String
 analyzedAt DateTime @default(now())
 analyzedReplyAt DateTime?
 @@unique([sessionId,chatId])
}

model RecoveryPreview {
 id String @id @default(cuid())
 sessionId String
 chatId String
 status String
 previewUrl String @default("")
 notes String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([sessionId,chatId])
 @@index([sessionId,status])
}

model RecoveryCommercial {
 id String @id @default(cuid())
 sessionId String
 chatId String
 phase String
 meetingAt DateTime?
 proposalAmount Int?
 notes String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([sessionId,chatId])
 @@index([sessionId,phase])
}

model RecoveryOutcome {
 id String @id @default(cuid())
 sessionId String
 chatId String
 result String
 contractAmount Int?
 reason String @default("")
 createdAt DateTime @default(now())
 @@unique([sessionId,chatId])
 @@index([sessionId,result])
}

model CaptureApproval {
 id String @id @default(cuid())
 leadId String @unique
 sessionId String
 chatId String
 status String @default("draft")
 messageText String @default("")
 approvedAt DateTime?
 sentAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([sessionId,chatId])
 @@index([status,createdAt])
}

model OutreachObservation {
  id String @id @default(cuid())
  sessionId String
  channel String
  chatId String
  leadId String?
  messageText String @default("")
  status String @default("unverified")
  category String @default("unclassified")
  evidence String @default("")
  aiCategory String @default("")
  aiReasoning String @default("")
  aiRecommendation String @default("")
  aiAnalyzedReplyAt DateTime?
  replyAt DateTime?
  checkedAt DateTime?
  lastError String @default("")
  updatedAt DateTime @updatedAt
  @@unique([sessionId,channel,chatId])
  @@index([sessionId,channel,status])
  @@index([sessionId,replyAt])
}

model CommercialOutcome {
 id String @id @default(cuid())
 sessionId String
 channel String
 chatId String
 stage String @default("contacted")
 meetingAt DateTime?
 proposalAmount Int?
 contractAmount Int?
 lossReason String @default("")
 notes String @default("")
 updatedAt DateTime @updatedAt
 createdAt DateTime @default(now())
 @@unique([sessionId,channel,chatId])
 @@index([sessionId,channel,stage])
}

model SocialPost {
 id String @id @default(cuid())
 r2CleanedAt DateTime?
 r2CleanupError String @default("")
 script String @default("")
 title String
 caption String @default("")
 mediaType String @default("image")
 mediaJson String @default("[]")
 platformsJson String @default("[]")
 status String @default("draft")
 scheduledAt DateTime?
 approvedAt DateTime?
 facebookStatus String @default("pending")
 instagramStatus String @default("pending")
 facebookPostId String?
 instagramPostId String?
 lastError String @default("")
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([status,scheduledAt])
}
