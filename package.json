    "test:repo": "node tests/repo.test.mjs",
    "test": "npm run test:services && npm run test:repo"
  },
  "dependencies": {
    "@prisma/client": "6.2.1",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "prisma": "6.2.1"
  }
}
