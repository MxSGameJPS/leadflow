{
  "name": "leadflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "seed": "node prisma/seed.js",
    "migrate": "prisma migrate dev --name init",
